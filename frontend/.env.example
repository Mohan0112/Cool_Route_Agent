# Leave empty for local dev -- Vite's dev-server proxy (vite.config.ts) forwards /api/* to
# http://127.0.0.1:8000. Set this to the deployed backend's URL only for production builds
# where frontend and backend are separate hosts (e.g. two Render services).
VITE_API_BASE_URL=

# Google Maps JavaScript API key -- get one at https://console.cloud.google.com/apis/credentials
# Ensure "Maps JavaScript API" is enabled on your Google Cloud project.
VITE_GOOGLE_MAPS_API_KEY=
