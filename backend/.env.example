FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

DEMO_MODE=true
CACHE_DB_PATH=./data/app.db
CORS_ORIGINS=http://localhost:5173

MAX_AGENT_TURNS=12
AGENT_TIMEOUT_S=180
POLL_BACKOFF_S=3,6,12,12,12

# Free, keyless OSM-based geocoding service -- default works out of the box, no signup needed.
# (Routing uses OpenStreetMap.de's per-mode OSRM demo servers, hardcoded in app/routing/client.py.)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
